# Said & Done — environment template (copy to .env.local and fill in; .env.local is gitignored)

# PayPal sandbox REST app (Developer Dashboard > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Gemini via Vercel AI SDK (@ai-sdk/google reads this variable name)
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Sandbox accounts used in the demo (business = seller, personal = buyer)
# Emails only here; passwords are shared with judges in the README run instructions, never committed.
PAYPAL_SANDBOX_BUSINESS_EMAIL=
PAYPAL_SANDBOX_PERSONAL_EMAIL=

# App settings
DEFAULT_CURRENCY=USD
DEMO_FX_USD_EUR=0.92
SELLER_NAME=
DEMO_MODE=false
STALL_TIMEZONE=America/Los_Angeles
